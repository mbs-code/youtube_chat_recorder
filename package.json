    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "eslint": "^10.4.2",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "eslint-plugin-vue": "^10.12.1",
    "fflate": "^0.8.3",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "marked": "^18.2.1",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
