{
  "name": "youtube_chat_recorder",
  "version": "2.0.2",
  "private": true,
  "description": "[Browser Extension] App to operate streaming chat.",
  "author": "mbs-code <mbscodec@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "build:dev": "node scripts/build.js --mode development",
    "watch": "node scripts/build.js --mode development --watch",
    "build-zip": "npm run build && node scripts/build-zip.js",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node scripts/vitest.js run",
    "test:watch": "node scripts/vitest.js",
    "e2e": "node scripts/e2e.js",
    "screenshots": "node scripts/screenshots.js",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "date-fns": "^4.4.0",
